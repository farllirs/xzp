{
  "name": "@nyxur/xzp",
  "version": "1.4.0",
  "type": "module",
  "description": "Professional visual CLI for Termux & Linux. Rich agent mode for AI/automation, safe execution, intelligent project context, cross-environment bridge (Termux ↔ proot-distro), and beautiful TUI navigation.",
  "keywords": [
    "termux",
    "linux",
    "android",
    "cli",
    "python",
    "node",
    "php",
    "ruby",
    "go",
    "rust",
    "java",
    "safe-shell"
  ],
  "license": "XZP",
  "bin": {
    "xzp": "bin/xzp",
    "xzp-project-context": "bin/xzp-project-context"
  },
  "scripts": {
    "start": "node ./bin/xzp.js",
    "help": "node ./bin/xzp.js --help",
    "test": "node --test ./tests/*.test.js",
    "assets:render": "node ./scripts/render-brand-assets.mjs",
    "pack:check": "npm pack --dry-run",
    "release:check": "npm test && npm pack --dry-run",
    "release:publish": "npm test && npm publish --access public && node scripts/release-gh.mjs"
  },
  "author": "farllirs",
  "files": [
    "bin/xzp",
    "bin/xzp.js",
    "bin/xzp-project-context",
    "bin/xzp-project-context.js",
    "src",
    "data/commands/explain.json",
    "data/locales",
    "assets",
    "snapshots",
    "README.md",
    "icon"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/farllirs/xzp.git"
  },
  "homepage": "https://github.com/farllirs/xzp#readme",
  "bugs": {
    "url": "https://github.com/farllirs/xzp/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2"
  }
}
